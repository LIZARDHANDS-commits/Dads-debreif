{
  // Starts the app for the desktop app's Browser pane (Ctrl+Shift+B; Ctrl+Shift+S picks an element).
  // Vite always uses port 5173; if that port is busy it stops with an error instead of moving.
  "version": "0.0.1",
  // Off so Claude doesn't screenshot after every edit; turn it on from the server dropdown.
  "autoVerify": false,
  "configurations": [
    {
      "name": "dads-ooda-loop",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173,
      "autoPort": false
    },
    {
      // A second copy on 5181 for a parallel worktree session (graphics), the port the CT-156 render scripts use.
      "name": "dads-ooda-loop-5181",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5181", "--strictPort"],
      "port": 5181,
      "autoPort": false
    }
  ]
}
