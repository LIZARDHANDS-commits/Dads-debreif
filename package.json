{
  "name": "dads-ooda-loop",
  "private": true,
  "version": "2.5.0",
  "description": "DAD's OODA LOOP: T-6 debrief and flight-training tools that run in any browser",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/check-size.mjs dist",
    "preview": "vite preview",
    "test": "node tools/unit-tests.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "test:e2e": "playwright test",
    "test:signoff": "node tools/unit-tests.mjs --all",
    "test:e2e:signoff": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "dependencies": {
    "three": "0.186.1",
    "uplot": "1.6.32"
  }
}
