# Normalize all text files to LF in Git index and working trees to prevent CRLF/LF merge conflicts
* text=auto eol=lf

# Windows batch and PowerShell scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never undergo text conversion
*.glb binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.webm binary
*.mp4 binary
*.gz binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
